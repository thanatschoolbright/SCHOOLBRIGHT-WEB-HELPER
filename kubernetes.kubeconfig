kind: Config
apiVersion: v1
preferences: {}
clusters:
  - name: internalCluster
    cluster:
      server: https://576526f0-2caf-11f1-a899-0255ac1001c6.cluster.cce.ap-southeast-2.myhuaweicloud.com:5443
      certificate-authority-data: >-
        
  - name: internalIPCluster
    cluster:
      server: https://10.0.0.49:5443
      certificate-authority-data: >-
        
  - name: externalCluster
    cluster:
      server: https://124.81.190.108:5443
      insecure-skip-tls-verify: true
  - name: externalClusterTLSVerify
    cluster:
      server: https://124.81.190.108:5443
      certificate-authority-data: >-
        
users:
  - name: user
    user:
      client-certificate-data: >-
        
      client-key-data: >-
        
contexts:
  - name: internal
    context:
      cluster: internalCluster
      user: user
  - name: internalIP
    context:
      cluster: internalIPCluster
      user: user
  - name: external
    context:
      cluster: externalCluster
      user: user
  - name: externalTLSVerify
    context:
      cluster: externalClusterTLSVerify
      user: user
current-context: external
