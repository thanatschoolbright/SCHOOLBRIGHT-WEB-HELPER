generator timesheet_client {
  provider      = "prisma-client-js"
  output        = "../../generated/prisma-timesheet"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource timesheet {
  provider = "postgresql"
  url      = env("DATABASE_TIMESHEET_URL")
}

enum ProjectAssetCaptureType {
  CAPTUREABLE
  UN_CAPTUREABLE
}

model Group {
  id       Int       @id @default(autoincrement()) @map("id")
  name_th  String    @map("name_th")
  name_en  String?   @map("name_en")
  projects Project[]

  @@map("group")
}

model Project {
  id              Int              @id @default(autoincrement()) @map("id")
  categoryType    String?          @map("category_type")
  name            String           @map("name")
  name_en         String?          @map("name_en")
  start_date      DateTime?        @map("start_date")
  end_date        DateTime?        @map("end_date")
  createdAt       DateTime         @default(now()) @map("created_at")
  createdBy       Int?             @map("created_by")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  updatedBy       Int?             @map("updated_by")
  description     String
  is_deleted      Boolean          @default(false)
  features        Feature[]
  timesheets      TimesheetEntry[]
  status          String           @default("open") @map("status")
  approval_status String           @default("pending") @map("approval_status")
  approval        String           @default("pending") @map("approval")
  group_id        Int              @map("group_id")
  group           Group?           @relation(fields: [group_id], references: [id])

  @@map("project")
}

model Feature {
  id                 Int                     @id @default(autoincrement()) @map("id")
  // boiType            String?                 @map("boi_type")
  projectId          Int                     @map("project_id")
  name               String                  @map("name")
  name_en            String?                 @map("name_en")
  backlogDescription Json?                   @map("backlog_description")
  createdAt          DateTime                @default(now()) @map("created_at")
  createdBy          Int?                    @map("created_by")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  updatedBy          Int?                    @map("updated_by")
  is_deleted         Boolean                 @default(false)
  startDate          DateTime?               @map("start_date")
  endDate            DateTime?               @map("end_date")
  project            Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetCaptureType   ProjectAssetCaptureType @default(CAPTUREABLE) @map("asset_capture_type")
  timesheets         TimesheetEntry[]
  status             String                  @default("open") @map("status")

  @@map("feature")
}

model TimesheetEntry {
  id          Int      @id @default(autoincrement()) @map("id")
  projectId   Int      @map("project_id")
  featureId   Int      @map("feature_id")
  date        DateTime @map("date")
  hours       Decimal  @map("hours")
  description String?  @map("description")
  status      String   @default("DRAFT") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   Int?     @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   Int?     @map("updated_by")
  is_deleted  Boolean  @default(false)
  feature     Feature  @relation(fields: [featureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("timesheet_entry")
}

model ApiLog {
  id             BigInt    @id @default(autoincrement()) @map("id")
  request_time   DateTime  @map("request_time")
  response_time  DateTime? @map("response_time")
  duration_ms    Int?      @map("duration_ms")
  method         String?   @map("method")
  status_code    Int?      @map("status_code")
  url            String?   @map("url")
  endpoint       String?   @map("endpoint")
  service_name   String?   @map("service_name")
  request_header Json?     @map("request_header")
  request_body   Json?     @map("request_body")
  response_body  Json?     @map("response_body")
  ip_address     String?   @map("ip_address")
  user_agent     String?   @map("user_agent")
  called_by      String?   @map("called_by")
  trace_id       String?   @map("trace_id")
  error_message  String?   @map("error_message")
  is_success     Boolean   @default(true) @map("is_success")
  created_at     DateTime  @default(now()) @map("created_at")
  is_archived    Boolean   @default(false) @map("is_archived")

  @@index([endpoint])
  @@index([service_name])
  @@index([status_code])
  @@index([request_time])
  @@index([trace_id])
  @@index([called_by])
  @@map("api_log")
}

model Overtime {
  id           Int                   @id @default(autoincrement()) @map("id")
  requesterId  String                @map("requester_id")
  requestDate  DateTime              @map("request_date")
  descriptions OvertimeDescription[] @relation("OvertimeDescriptions")
  status       String                @map("status")
  createdBy    String                @map("created_by")
  updatedBy    String?               @map("updated_by")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  isDeleted    Boolean               @default(false) @map("is_deleted")

  @@index([requesterId, isDeleted])
  @@index([status, isDeleted])
  @@index([requestDate])
  @@map("timesheet_overtime_requests")
}

model OvertimeDescription {
  id          Int       @id @default(autoincrement()) @map("id")
  overtimeId  Int       @map("overtime_id")
  date        DateTime? @map("date")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  duration    Decimal   @map("duration")
  description String    @map("description")
  assignee    String    @map("assignee")

  // relation
  overtime Overtime @relation("OvertimeDescriptions", fields: [overtimeId], references: [id], onDelete: Cascade)

  @@index([overtimeId])
  @@index([assignee, date])
  @@map("timesheet_overtime_descriptions")
}
